# Authoritative world storage (SQLite) and default deterministic seed
TRPG_DATA_DIR=./data
TRPG_DEFAULT_SEED=dev-seed

# Optional OpenAI-compatible LLM backend (OpenRouter, Ollama, vLLM, etc.)
# Leave SAGA_LLM_BASE_URL and SAGA_NARRATOR_MODEL empty for zero-API-key deterministic fallback.
SAGA_LLM_BASE_URL=
SAGA_LLM_API_KEY=
SAGA_NARRATOR_MODEL=
SAGA_INTENT_MODEL=
# Set to true to enable OpenAI-compatible natural-language intent classification even without a separate SAGA_INTENT_MODEL
SAGA_OPENAI_INTENT=false
SAGA_LLM_TIMEOUT_SECONDS=45
# Optional reasoning effort / JSON custom headers / JSON custom body overrides
SAGA_LLM_REASONING_EFFORT=
SAGA_LLM_CUSTOM_HEADERS=
SAGA_LLM_CUSTOM_BODY=

# Optional semantic memory sidecar (NMOS). Disabled when SAGA_NMOS_URL is empty.
SAGA_NMOS_URL=
SAGA_NMOS_API_KEY=
SAGA_NMOS_TIMEOUT_SECONDS=2
