{
  "$defs": {
    "ActorState": {
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array",
          "uniqueItems": true
        },
        "hp": {
          "default": 10,
          "title": "Hp",
          "type": "integer"
        },
        "inventory": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Inventory",
          "type": "object"
        },
        "location": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "max_hp": {
          "default": 10,
          "title": "Max Hp",
          "type": "integer"
        },
        "stats": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Stats",
          "type": "object"
        },
        "visited_rooms": {
          "items": {
            "type": "string"
          },
          "title": "Visited Rooms",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "actor_id"
      ],
      "title": "ActorState",
      "type": "object"
    },
    "CommittedEvent": {
      "properties": {
        "event": {
          "$ref": "#/$defs/GameEvent"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "state_hash_after": {
          "title": "State Hash After",
          "type": "string"
        },
        "state_hash_before": {
          "title": "State Hash Before",
          "type": "string"
        }
      },
      "required": [
        "event",
        "seq",
        "state_hash_before",
        "state_hash_after"
      ],
      "title": "CommittedEvent",
      "type": "object"
    },
    "Exit": {
      "additionalProperties": false,
      "properties": {
        "key_item": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Item"
        },
        "kind": {
          "default": "open",
          "enum": [
            "open",
            "door"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "to_room": {
          "minLength": 1,
          "title": "To Room",
          "type": "string"
        }
      },
      "required": [
        "to_room",
        "label"
      ],
      "title": "Exit",
      "type": "object"
    },
    "GameEvent": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "parent_event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Event Id"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "actor_id"
      ],
      "title": "GameEvent",
      "type": "object"
    },
    "MapGenerator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "MapGenerator",
      "type": "object"
    },
    "MapState": {
      "additionalProperties": false,
      "description": "A room graph. Exits are directed and keyed per room (ADR 0009).",
      "properties": {
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapGenerator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rooms": {
          "additionalProperties": {
            "$ref": "#/$defs/Room"
          },
          "minProperties": 1,
          "title": "Rooms",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "start_room": {
          "minLength": 1,
          "title": "Start Room",
          "type": "string"
        }
      },
      "required": [
        "start_room",
        "rooms"
      ],
      "title": "MapState",
      "type": "object"
    },
    "RollRecord": {
      "properties": {
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "modifier": {
          "default": 0,
          "title": "Modifier",
          "type": "integer"
        },
        "raw": {
          "items": {
            "type": "integer"
          },
          "title": "Raw",
          "type": "array"
        },
        "roll_key": {
          "title": "Roll Key",
          "type": "string"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "roll_key",
        "expression",
        "raw",
        "total"
      ],
      "title": "RollRecord",
      "type": "object"
    },
    "Room": {
      "additionalProperties": false,
      "properties": {
        "clues": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Clues",
          "type": "object"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "discovered_clues": {
          "items": {
            "type": "string"
          },
          "title": "Discovered Clues",
          "type": "array"
        },
        "exits": {
          "additionalProperties": {
            "$ref": "#/$defs/Exit"
          },
          "title": "Exits",
          "type": "object"
        },
        "loot": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Loot",
          "type": "object"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Room",
      "type": "object"
    },
    "RuleResolution": {
      "description": "Structured mechanical result; unresolved fictional choices are explicitly marked.",
      "properties": {
        "damage": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Damage"
        },
        "outcome": {
          "enum": [
            "failure",
            "tie",
            "success",
            "success_with_style",
            "miss",
            "hit",
            "critical_hit"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "pending_adjudication": {
          "default": false,
          "title": "Pending Adjudication",
          "type": "boolean"
        },
        "target": {
          "title": "Target",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "outcome",
        "total",
        "target"
      ],
      "title": "RuleResolution",
      "type": "object"
    },
    "RuleResult": {
      "properties": {
        "facts": {
          "items": {
            "type": "string"
          },
          "title": "Facts",
          "type": "array"
        },
        "patches": {
          "items": {
            "$ref": "#/$defs/StatePatch"
          },
          "title": "Patches",
          "type": "array"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rolls": {
          "items": {
            "$ref": "#/$defs/RollRecord"
          },
          "title": "Rolls",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/WorldState"
        },
        "trace": {
          "items": {
            "type": "string"
          },
          "title": "Trace",
          "type": "array"
        }
      },
      "required": [
        "state"
      ],
      "title": "RuleResult",
      "type": "object"
    },
    "StatePatch": {
      "properties": {
        "after": {
          "default": null,
          "title": "After"
        },
        "before": {
          "default": null,
          "title": "Before"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "StatePatch",
      "type": "object"
    },
    "WorldState": {
      "properties": {
        "actors": {
          "additionalProperties": {
            "$ref": "#/$defs/ActorState"
          },
          "title": "Actors",
          "type": "object"
        },
        "flags": {
          "additionalProperties": true,
          "title": "Flags",
          "type": "object"
        },
        "map": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quest_state": {
          "additionalProperties": true,
          "title": "Quest State",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "default": 0,
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "simulated_time": {
          "default": 0,
          "title": "Simulated Time",
          "type": "integer"
        },
        "world_id": {
          "minLength": 1,
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "world_id"
      ],
      "title": "WorldState",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "committed": {
      "$ref": "#/$defs/CommittedEvent"
    },
    "result": {
      "$ref": "#/$defs/RuleResult"
    },
    "runtime_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Runtime Version",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "committed",
    "result"
  ],
  "title": "JournalEntry",
  "type": "object"
}
