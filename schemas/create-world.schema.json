  "additionalProperties": false,
  "properties": {
    "ruleset_id": {
      "minLength": 1,
      "title": "Ruleset Id",
      "type": "string"
    },
    "ruleset_version": {
      "minLength": 1,
      "title": "Ruleset Version",
      "type": "string"
    },
    "scenario": {
      "anyOf": [
        {
          "maxLength": 2000000,
          "minLength": 2,
          "type": "string"
        },
