{
  "$defs": {
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 32000,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "developer"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "HostAction": {
      "additionalProperties": false,
      "properties": {
        "context_hidden": {
          "default": false,
          "title": "Context Hidden",
          "type": "boolean"
        },
        "message_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Message Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "text"
      ],
      "title": "HostAction",
      "type": "object"
    },
    "HostTurn": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/HostAction"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "actor_id": {
          "const": "player",
          "title": "Actor Id",
          "type": "string"
        },
        "chat_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Chat Id",
          "type": "string"
        },
        "host_instance_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Host Instance Id",
          "type": "string"
        },
        "purpose": {
          "const": "action",
          "title": "Purpose",
          "type": "string"
        },
        "rulebook": {
          "anyOf": [
            {
              "$ref": "#/$defs/RulebookAttachment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "enum": [
            1,
            2,
            3,
            4
          ],
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "host_instance_id",
        "chat_id",
        "actor_id",
        "purpose",
        "actions"
      ],
      "title": "HostTurn",
      "type": "object"
    },
    "RulebookAttachment": {
      "additionalProperties": false,
      "description": "A rulebook carried by an enabled RisuAI module; pins a world when it is created.",
      "properties": {
        "content": {
          "maxLength": 2000000,
          "minLength": 2,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "title": "RulebookAttachment",
      "type": "object"
    },
    "VertexNarrationOptions": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "items": {
            "maxLength": 4000,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Context",
          "type": "array"
        },
        "provider": {
          "const": "vertex",
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "provider"
      ],
      "title": "VertexNarrationOptions",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "messages": {
      "items": {
        "$ref": "#/$defs/ChatMessage"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "model": {
      "const": "saga-srd-demo",
      "title": "Model",
      "type": "string"
    },
    "narration": {
      "anyOf": [
        {
          "$ref": "#/$defs/VertexNarrationOptions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "risu_prompt": {
      "items": {
        "$ref": "#/$defs/ChatMessage"
      },
      "maxItems": 256,
      "title": "Risu Prompt",
      "type": "array"
    },
    "saga": {
      "$ref": "#/$defs/HostTurn"
    },
    "stream": {
      "default": false,
      "title": "Stream",
      "type": "boolean"
    }
  },
  "required": [
    "model",
    "messages",
    "saga"
  ],
  "title": "CompletionRequest",
  "type": "object"
}
