{
  "$defs": {
    "ActorState": {
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array",
          "uniqueItems": true
        },
        "hp": {
          "default": 10,
          "title": "Hp",
          "type": "integer"
        },
        "inventory": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Inventory",
          "type": "object"
        },
        "location": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "max_hp": {
          "default": 10,
          "title": "Max Hp",
          "type": "integer"
        },
        "stats": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Stats",
          "type": "object"
        },
        "visited_rooms": {
          "items": {
            "type": "string"
          },
          "title": "Visited Rooms",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "actor_id"
      ],
      "title": "ActorState",
      "type": "object"
    },
    "Exit": {
      "additionalProperties": false,
      "properties": {
        "key_item": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Item"
        },
        "kind": {
          "default": "open",
          "enum": [
            "open",
            "door"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "to_room": {
          "minLength": 1,
          "title": "To Room",
          "type": "string"
        }
      },
      "required": [
        "to_room",
        "label"
      ],
      "title": "Exit",
      "type": "object"
    },
    "MapGenerator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "MapGenerator",
      "type": "object"
    },
    "MapState": {
      "additionalProperties": false,
      "description": "A room graph. Exits are directed and keyed per room (ADR 0009).",
      "properties": {
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapGenerator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rooms": {
          "additionalProperties": {
            "$ref": "#/$defs/Room"
          },
          "minProperties": 1,
          "title": "Rooms",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "start_room": {
          "minLength": 1,
          "title": "Start Room",
          "type": "string"
        }
      },
      "required": [
        "start_room",
        "rooms"
      ],
      "title": "MapState",
      "type": "object"
    },
    "Room": {
      "additionalProperties": false,
      "properties": {
        "clues": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Clues",
          "type": "object"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "discovered_clues": {
          "items": {
            "type": "string"
          },
          "title": "Discovered Clues",
          "type": "array"
        },
        "exits": {
          "additionalProperties": {
            "$ref": "#/$defs/Exit"
          },
          "title": "Exits",
          "type": "object"
        },
        "loot": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Loot",
          "type": "object"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Room",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actors": {
      "additionalProperties": {
        "$ref": "#/$defs/ActorState"
      },
      "title": "Actors",
      "type": "object"
    },
    "flags": {
      "additionalProperties": true,
      "title": "Flags",
      "type": "object"
    },
    "map": {
      "anyOf": [
        {
          "$ref": "#/$defs/MapState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quest_state": {
      "additionalProperties": true,
      "title": "Quest State",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seq": {
      "default": 0,
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "simulated_time": {
      "default": 0,
      "title": "Simulated Time",
      "type": "integer"
    },
    "world_id": {
      "minLength": 1,
      "title": "World Id",
      "type": "string"
    }
  },
  "required": [
    "world_id"
  ],
  "title": "WorldState",
  "type": "object"
}
