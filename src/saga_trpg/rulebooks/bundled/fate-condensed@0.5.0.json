{
  "schema_version": 1,
  "id": "fate-condensed",
  "version": "0.5.0",
  "title": "Fate Condensed example",
  "license": {
    "id": "CC-BY-3.0",
    "url": "https://creativecommons.org/licenses/by/3.0/",
    "attribution": "Fate Condensed ©2020 Evil Hat Productions, LLC.\n\nThis work is based on Fate Condensed (found at http://www.faterpg.com/), a product of Evil Hat Productions, LLC, developed, authored, and edited by PK Sullivan, Lara Turner, Leonard Balsera, Fred Hicks, Richard Bellingham, Robert Hanz, Ryan Macklin, and Sophie Lagacé, and licensed for our use under the Creative Commons Attribution 3.0 Unported license (http://creativecommons.org/licenses/by/3.0/)."
  },
  "source": {
    "url": "https://fate-srd.com/downloads/CC-BY-SRDs.zip",
    "revision": "Fate-Condensed-SRD-CC-BY.html; SHA256 a0f556ce2415fe4dc88ff71e56755bb92e113a52f8041bda69b759b63782544e; checked 2026-10-04"
  },
  "modifications": "Selected unmodified-roll mechanics expressed as rulebook data; 4d3-8 represents four Fate dice. Original example actors and prompts. Costs remain explicit pending adjudications.",
  "stats": {
    "skill:*": {
      "type": "integer",
      "range": [
        -10,
        20
      ]
    }
  },
  "checks": {
    "fate": {
      "roll": "4d3-8",
      "advantage": "none"
    }
  },
  "outcomes": {
    "overcome": [
      {
        "when": "total - target < 0",
        "outcome": "failure",
        "pending": true
      },
      {
        "when": "total - target == 0",
        "outcome": "tie",
        "pending": true
      },
      {
        "when": "total - target < 3",
        "outcome": "success"
      },
      {
        "when": "total - target >= 3",
        "outcome": "success_with_style"
      }
    ],
    "advantage": [
      {
        "when": "total - target < 0",
        "outcome": "failure",
        "pending": true
      },
      {
        "when": "total - target == 0",
        "outcome": "tie"
      },
      {
        "when": "total - target < 3",
        "outcome": "success"
      },
      {
        "when": "total - target >= 3",
        "outcome": "success_with_style"
      }
    ]
  },
  "records": {
    "fate_aspects": {
      "fields": {
        "name": {
          "type": "text",
          "pattern": "^.{1,200}$"
        },
        "owner_id": {
          "type": "actor"
        },
        "free_invokes": {
          "type": "integer",
          "range": [
            0,
            10
          ]
        }
      },
      "unique": [
        "name"
      ]
    },
    "fate_boosts": {
      "fields": {
        "name": {
          "type": "text",
          "pattern": "^.{1,200}$"
        },
        "owner_id": {
          "type": "actor"
        }
      },
      "unique": [
        "name"
      ]
    }
  },
  "actions": {
    "overcome": {
      "role": "check",
      "input": {
        "skill": {
          "type": "text",
          "pattern": "^.{1,80}$"
        },
        "difficulty": {
          "type": "integer",
          "range": [
            -10,
            20
          ]
        },
        "boost_name": {
          "type": "text",
          "pattern": "^.{1,200}$",
          "default": "Temporary advantage"
        }
      },
      "check": "fate",
      "modifier": "actor.skill[input.skill]",
      "target": "input.difficulty",
      "outcomes": "overcome",
      "on_outcome": {
        "success_with_style": [
          {
            "record": "fate_boosts",
            "fields": {
              "name": "input.boost_name",
              "owner_id": "actor.id"
            }
          }
        ]
      }
    },
    "create_advantage": {
      "role": "check",
      "input": {
        "skill": {
          "type": "text",
          "pattern": "^.{1,80}$"
        },
        "difficulty": {
          "type": "integer",
          "range": [
            -10,
            20
          ]
        },
        "aspect_name": {
          "type": "text",
          "pattern": "^.{1,200}$"
        }
      },
      "requires": [
        {
          "unique": {
            "record": "fate_aspects",
            "field": "name",
            "value": "input.aspect_name"
          },
          "error": "this example supports creating new aspects only"
        }
      ],
      "check": "fate",
      "modifier": "actor.skill[input.skill]",
      "target": "input.difficulty",
      "outcomes": "advantage",
      "on_outcome": {
        "tie": [
          {
            "record": "fate_boosts",
            "fields": {
              "name": "input.aspect_name",
              "owner_id": "actor.id"
            }
          }
        ],
        "success": [
          {
            "record": "fate_aspects",
            "fields": {
              "name": "input.aspect_name",
              "owner_id": "actor.id",
              "free_invokes": "1"
            }
          }
        ],
        "success_with_style": [
          {
            "record": "fate_aspects",
            "fields": {
              "name": "input.aspect_name",
              "owner_id": "actor.id",
              "free_invokes": "2"
            }
          }
        ]
      }
    },
    "invoke": {
      "builtin": "record_adjust",
      "record": "fate_aspects",
      "field": "free_invokes",
      "sign": -1
    },
    "use_boost": {
      "builtin": "record_remove",
      "record": "fate_boosts"
    },
    "move": {
      "builtin": "map_move"
    }
  },
  "conditions": {},
  "items": {},
  "example_world": {
    "actors": {
      "player": {
        "stats": {
          "skill:investigate": 2,
          "skill:athletics": 1,
          "skill:notice": 3
        }
      }
    },
    "flags": {
      "fate_aspects": {},
      "fate_boosts": {}
    },
    "map": {
      "start_room": "harbor",
      "rooms": {
        "harbor": {
          "name": "부두",
          "description": "안개 낀 부두. 밧줄에 묶인 작은 배가 흔들린다.",
          "exits": {
            "north": {
              "to_room": "warehouse",
              "label": "북쪽 창고 문",
              "kind": "door"
            },
            "east": {
              "to_room": "lighthouse",
              "label": "동쪽 해안길",
              "kind": "open"
            }
          }
        },
        "warehouse": {
          "name": "창고",
          "description": "젖은 그물과 소금 냄새가 가득하다.",
          "exits": {
            "south": {
              "to_room": "harbor",
              "label": "남쪽 문",
              "kind": "door"
            }
          }
        },
        "lighthouse": {
          "name": "등대 아래",
          "description": "파도가 바위에 부딪혀 물보라가 튄다.",
          "exits": {
            "west": {
              "to_room": "harbor",
              "label": "서쪽 해안길",
              "kind": "open"
            },
            "up": {
              "to_room": "lamp_room",
              "label": "위쪽 나선 계단",
              "kind": "door"
            }
          }
        },
        "lamp_room": {
          "name": "등대 꼭대기",
          "description": "꺼진 등불 옆으로 바다가 내려다보인다.",
          "exits": {
            "down": {
              "to_room": "lighthouse",
              "label": "아래쪽 나선 계단",
              "kind": "door"
            }
          }
        }
      }
    }
  },
  "display": {
    "actor": [
      "skill:*"
    ],
    "records": [
      "fate_aspects",
      "fate_boosts"
    ],
    "world": [
      "location"
    ]
  },
  "implemented": [
    "overcome against static opposition",
    "four outcome grades",
    "create a new situation aspect",
    "one/two free invokes on new aspects",
    "boost records",
    "spending free invokes on an aspect",
    "using (removing) a boost",
    "hand-authored room-graph map; move between connected rooms"
  ],
  "not_implemented": [
    "character creation and advancement",
    "rerolls",
    "stunts and compels",
    "attack, defend, stress and consequences",
    "opposed rolls and existing-aspect advantages",
    "paid invocations, invoke effects on rolls, and applying costs"
  ],
  "narration": "Selected system: Fate Condensed example, version 0.5.0.\nUse overcome or create_advantage against static opposition, with a stored skill:<name> rating.\nFour journaled d3 faces map 1/2/3 to -1/0/+1. The recorded total includes the skill rating.\nAn overcome failure/tie, or failed advantage, leaves a fictional choice pending; do not state that\na cost or adverse aspect was applied. Successful new aspects and boosts are stored in world flags.\nUse invoke to spend one free invoke on a named aspect (rejected at zero) and use_boost to\nremove a named boost; neither changes a roll in this example, only the recorded counts.\nDo not use generic HP or SRD combat mechanics to fill in unsupported Fate rules.\n\nMove with move <exit>, where the exit key is shown in the status line. Describe only the current room and what the map block lists; never describe rooms behind ??? exits."
}
