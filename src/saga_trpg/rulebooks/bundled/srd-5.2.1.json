{
  "schema_version": 1,
  "id": "srd-5.2.1",
  "version": "0.4.0",
  "title": "SRD 5.2.1 example",
  "license": {
    "id": "CC-BY-4.0",
    "url": "https://creativecommons.org/licenses/by/4.0/",
    "attribution": "This work includes material from the System Reference Document 5.2.1 (“SRD 5.2.1”) by Wizards of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the Creative Commons Attribution 4.0 International License, available at https://creativecommons.org/licenses/by/4.0/legalcode."
  },
  "source": {
    "url": "https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf",
    "revision": "SRD 5.2.1, pages 6–8 and 16; checked 2026-10-04"
  },
  "modifications": "Selected mechanics expressed as rulebook data; original example actors and prompts. No source art, setting, or full rulebook is bundled.",

  "stats": {
    "strength": { "type": "integer", "range": [1, 30], "modifier": "(value - 10) // 2" },
    "dexterity": { "type": "integer", "range": [1, 30], "modifier": "(value - 10) // 2" },
    "constitution": { "type": "integer", "range": [1, 30], "modifier": "(value - 10) // 2" },
    "intelligence": { "type": "integer", "range": [1, 30], "modifier": "(value - 10) // 2" },
    "wisdom": { "type": "integer", "range": [1, 30], "modifier": "(value - 10) // 2" },
    "charisma": { "type": "integer", "range": [1, 30], "modifier": "(value - 10) // 2" },
    "proficiency_bonus": { "type": "integer", "range": [2, 9] },
    "armor_class": { "type": "integer", "range": [1, 100] },
    "weapon_ability": { "type": "text", "enum": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"] },
    "weapon_damage": { "type": "text", "pattern": "^([1-9]|[1-4][0-9]|50)d(4|6|8|10|12)$" },
    "weapon_proficient": { "type": "boolean", "default": false },
    "proficient:*": { "type": "boolean", "default": false },
    "save_proficient:*": { "type": "boolean", "default": false }
  },

  "checks": {
    "d20": { "roll": "1d20", "advantage": "roll_twice" }
  },

  "outcomes": {
    "check": [
      { "when": "total >= target", "outcome": "success" },
      { "when": "total < target", "outcome": "failure" }
    ],
    "attack": [
      { "when": "die == 20", "outcome": "critical_hit" },
      { "when": "die == 1", "outcome": "miss" },
      { "when": "total >= target", "outcome": "hit" },
      { "when": "total < target", "outcome": "miss" }
    ]
  },

  "actions": {
    "ability_check": {
      "role": "check",
      "input": {
        "ability": { "type": "text", "enum": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"] },
        "difficulty": { "type": "integer", "range": [1, 100] },
        "proficiency": { "type": "text", "pattern": "^.{1,80}$", "optional": true }
      },
      "check": "d20",
      "modifier": "mod[input.ability] + (actor.proficiency_bonus if input.proficiency != \"\" and actor.proficient[input.proficiency] else 0)",
      "target": "input.difficulty",
      "outcomes": "check"
    },
    "saving_throw": {
      "role": "save",
      "input": {
        "ability": { "type": "text", "enum": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"] },
        "difficulty": { "type": "integer", "range": [1, 100] }
      },
      "check": "d20",
      "modifier": "mod[input.ability] + (actor.proficiency_bonus if actor.save_proficient[input.ability] else 0)",
      "target": "input.difficulty",
      "outcomes": "check"
    },
    "attack": {
      "role": "attack",
      "input": { "target_id": { "type": "actor" } },
      "requires": [
        { "when": "actor.hp > 0", "error": "attack requires a conscious attacker" }
      ],
      "check": "d20",
      "modifier": "mod[actor.weapon_ability] + (actor.proficiency_bonus if actor.weapon_proficient else 0)",
      "target": "target.armor_class",
      "outcomes": "attack",
      "on_hit": {
        "dice": "actor.weapon_damage",
        "bonus": "mod[actor.weapon_ability]",
        "critical": "double_dice"
      }
    },
    "damage": { "builtin": "hp_change", "sign": -1 },
    "heal": { "builtin": "hp_change", "sign": 1 },
    "apply_condition": { "builtin": "condition_add" },
    "remove_condition": { "builtin": "condition_remove" },
    "advance_time": { "builtin": "time_advance", "units": { "round": 6, "minute": 60, "hour": 3600, "day": 86400 } },
    "give": { "builtin": "inventory_add" },
    "take": { "builtin": "inventory_remove" }
  },

  "conditions": {
    "blinded": { "attacker": "disadvantage", "target": "advantage" },
    "charmed": {},
    "deafened": {},
    "frightened": { "attacker": "disadvantage", "check": "disadvantage" },
    "grappled": {},
    "incapacitated": { "cannot_act": true },
    "invisible": { "attacker": "advantage", "target": "disadvantage" },
    "paralyzed": { "target": "advantage", "cannot_act": true },
    "petrified": { "target": "advantage", "cannot_act": true },
    "poisoned": { "attacker": "disadvantage", "check": "disadvantage" },
    "prone": { "attacker": "disadvantage" },
    "restrained": { "attacker": "disadvantage", "target": "advantage" },
    "stunned": { "target": "advantage", "cannot_act": true },
    "unconscious": { "target": "advantage", "cannot_act": true }
  },

  "items": {},

  "example_world": {
    "actors": {
      "player": {
        "hp": 20,
        "max_hp": 20,
        "stats": {
          "strength": 16,
          "dexterity": 12,
          "constitution": 14,
          "intelligence": 10,
          "wisdom": 12,
          "charisma": 10,
          "proficiency_bonus": 2,
          "save_proficient:strength": true,
          "proficient:athletics": true,
          "weapon_ability": "strength",
          "weapon_damage": "1d8",
          "weapon_proficient": true,
          "armor_class": 15
        }
      },
      "opponent": { "hp": 30, "max_hp": 30, "stats": { "armor_class": 13 } }
    }
  },

  "display": {"actor": ["hp", "conditions", "inventory"], "world": ["time"]},

  "implemented": [
    "ability checks",
    "saving throws",
    "one configured weapon attack",
    "advantage/disadvantage",
    "critical damage dice",
    "HP subtraction",
    "GM-declared damage and healing clamped to 0..max HP",
    "explicit named conditions without exhaustion levels",
    "condition effects on attack, check and save rolls from the conditions table",
    "simulated time in seconds with six-second rounds",
    "exact item counts per actor with closed item keys; no item effects"
  ],
  "not_implemented": [
    "character creation and advancement",
    "classes and spells",
    "initiative, range, movement and action economy",
    "resistances and vulnerabilities",
    "death saves, instant death and automatic unconsciousness",
    "prone against ranged attacks, condition durations and exhaustion levels",
    "item effects, equipment, weight and currency",
    "inspiration and rules rerolls"
  ],
  "narration": "Selected system: SRD 5.2.1 example, version 0.4.0.\nUse ability_check, saving_throw, or attack for rolls. Ability scores, proficiency, weapon data,\nand AC come from stored actor stats. The GM supplies the check difficulty and circumstances in\nvalidated input. Narrate the recorded resolution. Natural 1/20 overrides apply to attacks only.\nUse damage or heal for GM-declared hit point changes; HP is clamped to 0..max and nothing happens\nautomatically at 0 HP. Use apply_condition or remove_condition to change named conditions\nexplicitly. Conditions change rolls exactly as the recorded trace says: advantage or\ndisadvantage from the conditions table, and incapacitating conditions block rolls until removed.\nUse advance_time to move simulated time in rounds, minutes, hours, or days. Use give or take to\nchange an actor's exact item counts; items have no modelled effect. The recorded inventory is\nauthoritative; never invent items.\nUnsupported rules require a future implementation; never borrow Fate rules or invent their effects.\n"
}
